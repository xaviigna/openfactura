{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./extensiones": "./src/sdk-extensiones.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "wrangler dev --port 8788",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "openapi": "bun src/openapi.cli.ts",
    "auth:schema": "bunx auth@latest generate --config src/auth.cli.ts --output src/db/auth-schema.ts -y",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openfactura/dte": "workspace:*",
    "better-auth": "^1.7.21",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.160.1"
  }
}
