  "components": {
    "securitySchemes": {
      "clave": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clave de API (`of_test_…` / `of_live_…`)."
      },
      "plataforma": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clave de API tuya habilitada para Plataforma."
      }
    },
    "schemas": {
      "DatosCliente": {
        "type": ["object", "null"],
        "description": "Lo que ya sabes del cliente; prellena su alta.",
        "properties": {
          "nit": {
            "type": "string",
            "example": "0614-290786-102-3"
          },
          "nrc": {
            "type": "string",
            "example": "123456-7"
          },
          "razonSocial": {
            "type": "string"
          },
          "nombreComercial": {
            "type": "string"
          },
          "correo": {
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "type": "string"
          }
        }
      },
      "ClientePlataforma": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "externalId": {
            "type": ["string", "null"]
          },
          "estado": {
            "type": "string",
            "enum": ["pendiente", "activo", "desactivado"]
          },
          "datos": {
            "$ref": "#/components/schemas/DatosCliente"
          },
          "organizationId": {
            "type": ["string", "null"],
            "description": "Su espacio (existe desde que lo creas)."
          },
          "preparacion": {
            "type": ["string", "null"],
            "enum": ["conectado", "pruebas", "produccion", null]
          },
          "falta": {
            "type": ["string", "null"],
            "example": "Sus credenciales de producción"
          },
          "enlaceExpira": {
            "type": ["integer", "null"]
          },
          "aceptado": {
            "type": ["integer", "null"]
          },
          "creado": {
            "type": "integer"
          }
        }
      },
      "EmpresaCliente": {
        "type": "object",
        "properties": {
          "nit": {
            "type": "string"
          },
          "nrc": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "nombreComercial": {
            "type": ["string", "null"]
          },
          "actividad": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          },
          "ambiente": {
            "type": "string",
            "enum": ["00", "01"]
          },
          "credenciales": {
            "type": "object",
            "properties": {
              "pruebas": {
                "type": "boolean"
              },
              "produccion": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ClaveEntrada": {
        "type": "object",
        "required": ["nombre", "modo", "scopes"],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 80,
            "example": "POS Casa Barista"
          },
          "modo": {
            "type": "string",
            "enum": ["test", "live"]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["dte:emit", "dte:read"]
          },
          "expiraEnDias": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 3650
          }
        }
      },
      "Clave": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "prefijo": {
            "type": "string"
          },
          "modo": {
            "type": "string",
            "enum": ["test", "live"]
          },
          "estado": {
            "type": "string"
          },
          "creado": {
            "type": "integer"
          }
        }
      },
      "ClaveCreada": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Clave"
          },
          {
            "type": "object",
            "properties": {
              "clave": {
                "type": "string",
                "description": "Sólo aparece aquí.",
                "example": "of_live_…"
              }
            }
          }
        ]
      },
      "WebhookEntrada": {
        "type": "object",
        "required": ["url", "eventos"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://pos.casabarista.sv/webhooks/openfactura"
          },
          "descripcion": {
            "type": ["string", "null"]
          },
          "eventos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["dte.procesado", "dte.rechazado"]
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "descripcion": {
            "type": ["string", "null"]
          },
          "eventos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "WebhookCreado": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Webhook"
          },
          {
            "type": "object",
            "properties": {
              "secreto": {
                "type": "string",
                "description": "Sólo aparece aquí.",
                "example": "whsec_…"
              }
            }
          }
        ]
      },
      "Marca": {
        "type": "object",
        "properties": {
          "logo": {
            "type": ["object", "null"],
            "properties": {
              "tipo": {
                "type": "string",
                "enum": ["png", "jpg"]
              },
              "url": {
                "type": "string",
                "description": "data URL"
              }
            }
          },
          "correoRespuesta": {
            "type": ["string", "null"]
          },
          "ocultarOpenFactura": {
            "type": "boolean"
          },
          "puedeOcultar": {
            "type": "boolean",
            "description": "Tu plan lo incluye (Pro y Platform)."
          }
        }
      },
      "Envio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "para": {
            "type": "string"
          },
          "origen": {
            "type": "string",
            "enum": ["auto", "manual"]
          },
          "estado": {
            "type": "string",
            "enum": ["pendiente", "enviado", "fallido"]
          },
          "intentos": {
            "type": "integer"
          },
          "creado": {
            "type": "integer"
          }
        }
      },
      "Certificacion": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "enum": ["sin_iniciar", "en_curso", "detenida", "completa"]
          },
          "clienteCcfId": {
            "type": ["string", "null"]
          },
          "requisitos": {
            "type": "object"
          },
          "avance": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "ultimoError": {
            "type": ["string", "null"]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "plan_requerido"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      }
    },
    "responses": {
      "E400": {
        "description": "Datos inválidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Falta la clave o la sesión",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Tu plan no lo incluye (`plan_requerido`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E403": {
        "description": "Sin permiso o clave no habilitada para Plataforma (`clave_sin_plataforma`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "No existe o no es tuyo",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E409": {
        "description": "Conflicto (p. ej. `cliente_no_pendiente`, `external_id_repetido`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E429": {
        "description": "Límite de empresas del plan (`limite_plan`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
