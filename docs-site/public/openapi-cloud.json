              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaveCreada"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaveEntrada"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id del cliente (`cli_…` o uuid)"
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      },
      "get": {
        "operationId": "plataforma_cliente_claves",
