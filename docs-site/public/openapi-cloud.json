    "/api/v1/ext/marca": {
      "get": {
        "operationId": "marca_obtener",
        "tags": ["Marca"],
        "summary": "Ver la marca",
        "description": "Logo (data URL), correo de respuesta y si se oculta «Open Factura». Permiso `emisor:read`.",
        "responses": {
          "200": {
            "description": "Marca.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Marca"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          }
        }
      },
      "put": {
        "operationId": "marca_actualizar",
        "tags": ["Marca"],
        "summary": "Cambiar correo de respuesta u «Ocultar Open Factura»",
        "description": "`ocultarOpenFactura` está incluido en Pro y Platform (si no, 402). Permiso `emisor:write`.",
        "responses": {
          "200": {
            "description": "Marca.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Marca"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "correoRespuesta": {
                    "type": ["string", "null"],
                    "format": "email"
                  },
                  "ocultarOpenFactura": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ext/marca/logo": {
      "put": {
        "operationId": "marca_logo_subir",
        "tags": ["Marca"],
        "summary": "Subir el logo",
