    "/api/v1/ext/correo/dte/{codigo}": {
      "post": {
        "operationId": "dte_enviar_correo",
        "tags": ["Correo"],
        "summary": "Enviar un DTE por correo",
        "description": "Envía (o reenvía) un DTE sellado con su PDF y su JSON oficial. Por defecto al receptor. Los de producción se envían solos al sellarse. Permiso `dte:emit`.",
        "responses": {
          "200": {
            "description": "Envío.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envio"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "para": {
                    "type": "string",
                    "format": "email",
                    "description": "Otra dirección; por defecto el receptor."
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Código de generación del DTE"
          }
        ]
      },
      "get": {
        "operationId": "dte_envios_listar",
        "tags": ["Correo"],
        "summary": "Ver los envíos de un DTE",
        "description": "Permiso `dte:read`.",
        "responses": {
          "200": {
            "description": "Envíos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Envio"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        },
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Código de generación del DTE"
          }
        ]
      }
    },
    "/api/v1/ext/certificacion": {
      "get": {
        "operationId": "certificacion_estado",
        "tags": ["Certificación"],
        "summary": "Avance de las pruebas mínimas",
        "description": "Estado, requisitos y avance por tipo. Permiso `dte:read`.",
        "responses": {
          "200": {
            "description": "Certificación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificacion"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          }
        }
      }
    },
    "/api/v1/ext/certificacion/iniciar": {
      "post": {
        "operationId": "certificacion_iniciar",
        "tags": ["Certificación"],
        "summary": "Iniciar o retomar la certificación",
        "description": "Receptor de los Créditos Fiscales de prueba: `openfactura` (Open Factura, se agrega a tus Clientes) o el id de un cliente contribuyente; Hacienda no acepta el propio emisor. Permisos `dte:emit` y `dte:invalidate`.",
        "responses": {
          "200": {
            "description": "Certificación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificacion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clienteCcfId": {
                    "type": ["string", "null"],
                    "example": "openfactura"
                  },
                  "desdeCero": {
                    "type": "boolean"
                  },
                  "alcance": {
                    "type": "string",
                    "enum": ["minimo", "completo"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ext/certificacion/avanzar": {
      "post": {
        "operationId": "certificacion_avanzar",
        "tags": ["Certificación"],
        "summary": "Emitir la siguiente tanda",
        "description": "Hasta 5 pruebas por llamada, en el ambiente de pruebas. Llama de nuevo mientras `estado` sea `en_curso`. Permisos `dte:emit` y `dte:invalidate`.",
        "responses": {
          "200": {
            "description": "Certificación.",
