{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Factura Cloud",
    "version": "1.0.0",
    "description": "Lo que suma la versión administrada a la API de siempre: Plataforma (integra a tus clientes), Marca, Correo y Certificación. Mismo formato de errores que la API del núcleo."
  },
  "servers": [
    {
      "url": "https://app.openfactura.co"
    }
  ],
  "security": [
    {
      "clave": []
    }
  ],
  "tags": [
    {
      "name": "Plataforma",
      "description": "Un desarrollador, muchos clientes: cada uno en su espacio aislado. Con una clave tuya habilitada para Plataforma (panel → Clientes → Acceso por API)."
    },
    {
      "name": "Marca"
    },
    {
      "name": "Correo"
    },
    {
      "name": "Certificación"
    }
  ],
  "paths": {
    "/cloud/plataforma/clientes": {
      "post": {
        "operationId": "plataforma_cliente_crear",
        "tags": ["Plataforma"],
        "summary": "Crear un cliente",
        "description": "Crea un cliente pendiente con su propio espacio (organización aislada). Lo que ya sabes de él (`datos`) llega prellenado a su alta.",
        "responses": {
          "201": {
            "description": "Cliente creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientePlataforma"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          },
          "429": {
            "$ref": "#/components/responses/E429"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nombre"],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120,
                    "example": "Casa Barista"
                  },
                  "externalId": {
                    "type": ["string", "null"],
                    "maxLength": 120,
                    "description": "Tu propio id del cliente; único en tu cuenta.",
                    "example": "cliente-482"
                  },
                  "datos": {
                    "$ref": "#/components/schemas/DatosCliente"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "plataforma": []
          }
        ]
      },
      "get": {
        "operationId": "plataforma_clientes_listar",
        "tags": ["Plataforma"],
        "summary": "Listar clientes",
        "description": "Tus clientes con su estado, qué tan listos están para emitir (`preparacion`) y qué les falta (`falta`).",
        "responses": {
          "200": {
            "description": "Clientes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClientePlataforma"
                  }
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          }
        },
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["pendiente", "activo", "desactivado"]
            },
            "description": "Filtra por estado."
          },
          {
            "name": "externalId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca por tu id."
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      }
    },
    "/cloud/plataforma/clientes/{id}": {
      "get": {
        "operationId": "plataforma_cliente_obtener",
        "tags": ["Plataforma"],
        "summary": "Obtener un cliente",
        "description": "Un cliente con su estado y preparación.",
        "responses": {
          "200": {
            "description": "Cliente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientePlataforma"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id del cliente (`cli_…` o uuid)"
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      },
      "delete": {
        "operationId": "plataforma_cliente_eliminar",
        "tags": ["Plataforma"],
        "summary": "Eliminar o desactivar un cliente",
        "description": "Pendiente: se elimina con su espacio. Activo: se desactiva; pierdes el acceso, se revocan tus claves y webhooks en su espacio, y sus datos siguen siendo suyos.",
        "responses": {
          "200": {
            "description": "Hecho."
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id del cliente (`cli_…` o uuid)"
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      }
    },
    "/cloud/plataforma/clientes/{id}/enlace": {
      "post": {
        "operationId": "plataforma_cliente_enlace",
        "tags": ["Plataforma"],
        "summary": "Crear el enlace de alta",
        "description": "Enlace de un solo uso para que el cliente active su cuenta (queda como dueño). Uno nuevo invalida al anterior.",
        "responses": {
          "201": {
            "description": "Enlace.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "example": "https://app.openfactura.co/cloud/alta/9fK…"
                    },
                    "expira": {
                      "type": "integer",
                      "description": "ms desde 1970"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "409": {
            "$ref": "#/components/responses/E409"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expiraEnHoras": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 168,
                    "default": 72
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id del cliente (`cli_…` o uuid)"
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      }
    },
    "/cloud/plataforma/clientes/{id}/empresa": {
      "get": {
        "operationId": "plataforma_cliente_empresa",
        "tags": ["Plataforma"],
        "summary": "Ver su empresa ante Hacienda",
        "description": "Datos fiscales del cliente y qué credenciales del MH cargó. Nunca devuelve las credenciales.",
        "responses": {
          "200": {
            "description": "Empresa, o null si aún no la registra.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/EmpresaCliente"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id del cliente (`cli_…` o uuid)"
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      }
    },
    "/cloud/plataforma/clientes/{id}/uso": {
      "get": {
        "operationId": "plataforma_cliente_uso",
        "tags": ["Plataforma"],
        "summary": "DTE del mes",
        "description": "DTE de producción del cliente cubiertos por tu plan en un mes.",
        "responses": {
          "200": {
            "description": "Uso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "periodo": {
                      "type": "string",
                      "example": "2026-11"
                    },
                    "dte": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "403": {
            "$ref": "#/components/responses/E403"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id del cliente (`cli_…` o uuid)"
          },
          {
            "name": "periodo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "description": "AAAA-MM; por defecto el mes en curso."
          }
        ],
        "security": [
          {
            "plataforma": []
          }
        ]
      }
    },
    "/cloud/plataforma/clientes/{id}/claves": {
      "post": {
        "operationId": "plataforma_cliente_clave_crear",
