  "description": "Cliente de línea de comandos y servidor MCP (stdio) de Open Factura: facturación electrónica de El Salvador (DTE).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaviigna/openfactura.git",
    "directory": "packages/cli"
  },
